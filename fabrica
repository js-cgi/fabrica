import { DB } from "./framework/DB.js";
import { Fabrica } from "./framework/Fabrica.js";
import { database } from "./config/database.js";

function println(msg) { print((msg || "") + "\n"); }

const command = argv[0];

if (!command) {
    println("Fabrica v" + Fabrica.VERSION + " - MVC Framework for JS-CGI");
    println("Usage: js-cgi fabrica <command>");
    println("\nAvailable commands:");
    println("  serve              Start development server on port 8000");
    println("  routes             List all registered routes");
    println();
    println("  migrate            Run pending migrations");
    println("  migrate:rollback   Rollback the last batch of migrations");
    println("  migrate:fresh      Drop all tables and re-run migrations");
    println("  migrate:status     Show migration status");
    println();
    println("  db:seed            Run database seeders");
    println("  db:seed <name>     Run a specific seeder");
    println();
    println("  make:controller <name>   Create a new controller");
    println("  make:model <name>        Create a new model");
    println("  make:migration <name>    Create a new migration");
    println("  make:middleware <name>   Create a new middleware");
    println("  make:seeder <name>       Create a new seeder");
} else if (command === "serve") {
    serve();
} else if (command === "routes") {
    routes();
} else if (command === "migrate" || command === "migrate:rollback" || command === "migrate:status" || command === "migrate:fresh") {
    if (database.driver === "none") {
        println("Error: No database driver configured. Set a driver in config/database.js to run migrations.");
    } else {
        DB.connect();

        if (command === "migrate") {
            await migrate();
        } else if (command === "migrate:rollback") {
            await rollback();
        } else if (command === "migrate:status") {
            status();
        } else if (command === "migrate:fresh") {
            await migrateFresh();
        }

        DB.close();
    }
} else if (command === "db:seed") {
    if (database.driver === "none") {
        println("Error: No database driver configured. Set a driver in config/database.js to run seeders.");
    } else {
        DB.connect();
        await seed();
        DB.close();
    }
} else if (command.startsWith("make:")) {
    make(command, argv[1]);
} else {
    println("Error: Unknown command '" + command + "'");
}

function serve() {
    const port = argv[1] || "8000";
    println("Starting development server on port " + port + "...");
    println("Run: js-cgi --serve " + port + " --router index.js");
}

function routes() {
    import("./routes.js").then(() => {
        import("./framework/Router.js").then(mod => {
            const list = mod.Router.list();
            println("Registered Routes:");
            println();
            println("  METHOD  PATH                          MIDDLEWARE");
            println("  " + "-".repeat(60));
            for (const route of list) {
                const method = route.method.padEnd(6);
                const path = route.path.padEnd(30);
                const mw = route.middleware.length ? route.middleware.join(", ") : "-";
                println("  " + method + "  " + path + "  " + mw);
            }
            println();
            println("  Total: " + list.length + " routes");
        });
    });
}

async function migrate() {
    DB.exec(`CREATE TABLE IF NOT EXISTS migrations (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        migration TEXT NOT NULL,
        batch INTEGER NOT NULL
    )`);

    const ran = DB.raw("SELECT migration FROM migrations");
    const ranNames = ran.map(r => r.migration);

    const files = file.list("./database/migrations");
    if (!files || files.length === 0) {
        println("Nothing to migrate.");
        return;
    }

    const pending = files.filter(f => f.endsWith(".js") && !ranNames.includes(f)).sort();

    if (pending.length === 0) {
        println("Nothing to migrate.");
        return;
    }

    const batchResult = DB.raw("SELECT MAX(batch) as batch FROM migrations");
    const batch = (batchResult[0].batch || 0) + 1;

    for (const migration of pending) {
        const mod = await import("./database/migrations/" + migration);
        mod.up();
        DB.exec("INSERT INTO migrations (migration, batch) VALUES (?, ?)", [migration, batch]);
        println("Migrated: " + migration);
    }
}

async function rollback() {
    DB.exec(`CREATE TABLE IF NOT EXISTS migrations (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        migration TEXT NOT NULL,
        batch INTEGER NOT NULL
    )`);

    const batchResult = DB.raw("SELECT MAX(batch) as batch FROM migrations");
    const batch = batchResult[0].batch;

    if (!batch) {
        println("Nothing to rollback.");
        return;
    }

    const migrations = DB.raw("SELECT migration FROM migrations WHERE batch = ? ORDER BY id DESC", [batch]);

    for (const row of migrations) {
        const mod = await import("./database/migrations/" + row.migration);
        if (mod.down) {
            mod.down();
        }
        DB.exec("DELETE FROM migrations WHERE migration = ?", [row.migration]);
        println("Rolled back: " + row.migration);
    }
}

async function migrateFresh() {
    const tables = DB.raw("SELECT name FROM sqlite_master WHERE type='table' AND name != 'sqlite_sequence'");
    for (const t of tables) {
        DB.exec("DROP TABLE IF EXISTS " + t.name);
    }
    println("Dropped all tables.");
    await migrate();
}

function status() {
    DB.exec(`CREATE TABLE IF NOT EXISTS migrations (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        migration TEXT NOT NULL,
        batch INTEGER NOT NULL
    )`);

    const ran = DB.raw("SELECT migration, batch FROM migrations ORDER BY batch, id");
    const files = file.list("./database/migrations");
    const allMigrations = files ? files.filter(f => f.endsWith(".js")).sort() : [];

    if (allMigrations.length === 0) {
        println("No migrations found.");
        return;
    }

    println("Migration Status:");
    println();
    for (const m of allMigrations) {
        const record = ran.find(r => r.migration === m);
        if (record) {
            println("  [Ran] " + m + " (batch " + record.batch + ")");
        } else {
            println("  [Pending] " + m);
        }
    }
}

async function seed() {
    const name = argv[1];

    if (name) {
        const seederFile = name.endsWith(".js") ? name : name + ".js";
        const path = "./database/seeders/" + seederFile;

        if (!file.exists(path)) {
            println("Error: Seeder not found: " + seederFile);
            return;
        }

        const mod = await import(path);
        mod.run();
        println("Seeded: " + seederFile);
    } else {
        const mod = await import("./database/seeders/DatabaseSeeder.js");
        mod.run();
        println("Seeded: DatabaseSeeder.js");
    }
}

function make(command, name) {
    if (!name) {
        println("Error: Please provide a name. Usage: js-cgi fabrica " + command + " <name>");
        return;
    }

    const type = command.replace("make:", "");

    switch (type) {
        case "controller":
            makeController(name);
            break;
        case "model":
            makeModel(name);
            break;
        case "migration":
            makeMigration(name);
            break;
        case "middleware":
            makeMiddleware(name);
            break;
        case "seeder":
            makeSeeder(name);
            break;
        default:
            println("Error: Unknown make command: " + type);
    }
}

function makeController(name) {
    const filename = name.endsWith("Controller") ? name : name + "Controller";
    const path = "./app/controllers/" + filename + ".js";

    if (file.exists(path)) {
        println("Error: Controller already exists: " + path);
        return;
    }

    const content = 'import { Response } from "../../framework/Response.js";\n\nexport const ' + filename + ' = {\n    index(ctx) {\n        //\n    }\n};\n';
    file.write(path, content);
    println("Created: " + path);
}

function makeModel(name) {
    const path = "./app/models/" + name + ".js";

    if (file.exists(path)) {
        println("Error: Model already exists: " + path);
        return;
    }

    const tableName = name.toLowerCase() + "s";
    const content = 'import { Model } from "../../framework/Model.js";\n\nexport class ' + name + ' extends Model {\n    table = "' + tableName + '";\n    fillable = [];\n}\n';
    file.write(path, content);
    println("Created: " + path);
}

function makeMigration(name) {
    const files = file.list("./database/migrations");
    const existing = files ? files.filter(f => f.endsWith(".js")).sort() : [];
    const nextNum = String(existing.length + 1).padStart(3, "0");
    const filename = nextNum + "_" + name + ".js";
    const path = "./database/migrations/" + filename;

    const content = 'import { DB } from "../../framework/DB.js";\n\nexport function up() {\n    DB.exec(`CREATE TABLE IF NOT EXISTS ' + name + ' (\n        id INTEGER PRIMARY KEY AUTOINCREMENT,\n        created_at TEXT NOT NULL,\n        updated_at TEXT NOT NULL\n    )`);\n}\n\nexport function down() {\n    DB.exec(`DROP TABLE IF EXISTS ' + name + '`);\n}\n';
    file.write(path, content);
    println("Created: " + path);
}

function makeMiddleware(name) {
    const path = "./app/middleware/" + name + ".js";

    if (file.exists(path)) {
        println("Error: Middleware already exists: " + path);
        return;
    }

    const content = 'import { Response } from "../../framework/Response.js";\n\nexport function ' + name + 'Middleware(ctx) {\n    // Return false to halt the request\n    return true;\n}\n';
    file.write(path, content);
    println("Created: " + path);
}

function makeSeeder(name) {
    const filename = name.endsWith("Seeder") ? name : name + "Seeder";
    const path = "./database/seeders/" + filename + ".js";

    if (file.exists(path)) {
        println("Error: Seeder already exists: " + path);
        return;
    }

    const content = 'import { DB } from "../../framework/DB.js";\n\nexport function run() {\n    //\n}\n';
    file.write(path, content);
    println("Created: " + path);
}
